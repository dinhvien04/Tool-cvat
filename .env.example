# 9Router Configuration
# On host: http://127.0.0.1:20128
# In Docker/Nuclio container: http://host.docker.internal:20128
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=
NINEROUTER_TIMEOUT=60.0

# Preferred Vision Model for 2D Bounding Box Detection
# Options: ag/gemini-3.8-flash-high, ag/gemini-3.8-flash, ag/claude-sonnet-4-6, etc.
VISION_MODEL=ag/gemini-3.8-flash-high

# Pipeline Configuration
MAX_IMAGE_SIZE=1600
OUTPUT_DIR=output
LABELS_CONFIG=config/labels.yaml
FALLBACK_CONFIDENCE=1.0
