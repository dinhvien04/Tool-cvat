# 9Router Configuration
# On host: http://127.0.0.1:20128
# In Docker/Nuclio container: http://host.docker.internal:20128
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=
NINEROUTER_TIMEOUT=45.0

# CVAT API credentials for local verification/profiling (never commit real values)
CVAT_URL=http://localhost:18080
CVAT_ACCESS_TOKEN=
CVAT_JOB_ID=
CVAT_FRAME_ID=0

# Preferred Vision Models
# Default fallback model across all detectors:
VISION_MODEL=ag/gemini-3.8-flash-low

# Dedicated detector-specific models (fall back to VISION_MODEL if unset):
# Detector #1: Rectangle + Mask (14 foreground instance labels)
# Recommended: ag/gemini-3.8-flash-low (4.6s latency, 0 reasoning tokens)
RECTANGLE_MASK_MODEL=ag/gemini-3.8-flash-low

# Detector #2: Polygon + Mask (10 semantic region labels)
# Recommended: ag/gemini-3.8-flash-low (3.8s latency, 0 reasoning tokens)
POLYGON_MASK_MODEL=ag/gemini-3.8-flash-low

# Detector #3: Polyline (7 lane demarcation labels)
# Recommended: ag/gemini-3.8-flash-low (4.3s latency, 165 reasoning tokens)
POLYLINE_MODEL=ag/gemini-3.8-flash-low

# Pipeline Configuration
MAX_IMAGE_SIZE=1600
OUTPUT_DIR=output
LABELS_CONFIG=config/labels.yaml
FALLBACK_CONFIDENCE=1.0
